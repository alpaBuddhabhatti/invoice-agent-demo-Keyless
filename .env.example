############################################
# Microsoft Foundry (Azure AI Foundry)      #
############################################

# Foundry project endpoint URL
# (In the Foundry portal, look for something like "Project endpoint".)
FOUNDRY_PROJECT_ENDPOINT=https://your-foundry-project-endpoint

# Model deployment name configured for your project
MODEL_DEPLOYMENT_NAME=gpt-4o-mini

############################################
# Keyless auth (Microsoft Entra ID)
############################################
# Local dev: sign in with Azure CLI (`az login`) or VS Code Azure sign-in.
# Azure compute: enable Managed Identity.
# Optional: for user-assigned managed identity set `AZURE_CLIENT_ID`.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Compatibility: the code also accepts these for model name.
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o-mini
