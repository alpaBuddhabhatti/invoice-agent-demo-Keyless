########################################
# Azure OpenAI / Foundry model endpoint #
########################################

# Resource-style endpoint (not a Foundry project URL)
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Deployment name in your Azure OpenAI resource
AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini

# Optional override (Agent Framework default is usually fine)
# AZURE_OPENAI_API_VERSION=2024-06-01

# Optional transport tuning
# AZURE_OPENAI_TIMEOUT_SECONDS=60
# AZURE_OPENAI_MAX_RETRIES=2

#########################################
# Auth option B: Keyless (Microsoft Entra ID)
#########################################
# Local dev: sign in with Azure CLI (`az login`) or VS Code Azure sign-in.
# Azure compute: enable Managed Identity.
# Optional: for user-assigned managed identity set `AZURE_CLIENT_ID`.
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Optional token scope/endpoint; Agent Framework defaults this value.
# AZURE_OPENAI_TOKEN_ENDPOINT=https://cognitiveservices.azure.com/.default
#
